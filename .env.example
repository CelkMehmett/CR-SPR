# Example env variables for Alerts
ALERT_SMTP_HOST=smtp.example.com
ALERT_SMTP_PORT=587
ALERT_SMTP_USER=bot@example.com
ALERT_SMTP_PASS=supersecret
ALERT_EMAIL_TO=ops-team@example.com

# Telegram
ALERT_TELEGRAM_BOT=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
ALERT_TELEGRAM_CHAT=987654321

# Optional: encryption key for checkpoint blobs. Either a 32-byte hex string
# (64 hex chars) or a passphrase (will be hashed with SHA256).
# CHECKPOINT_ENC_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
